# ============================================================
# IBM watsonx.ai / IBM Cloud Configuration
# ============================================================
# Get these from: https://cloud.ibm.com/
# 1. Create a watsonx.ai project at https://dataplatform.cloud.ibm.com/
# 2. Generate an API key at: IBM Cloud > Manage > Access (IAM) > API Keys
# 3. Copy your Project ID from the watsonx.ai project settings

IBM_API_KEY=your_ibm_api_key_here
IBM_PROJECT_ID=your_watsonx_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite Model ID (Lite tier — free to use)
# Use the current generation instruct model. granite-13b-chat-v2 is retired.
IBM_GRANITE_MODEL_ID=ibm/granite-3-2-8b-instruct

# ============================================================
# Application Settings
# ============================================================
APP_NAME=Fitness Buddy
APP_ENV=development
DEBUG=False

# ============================================================
# Guardrail Settings
# ============================================================
MAX_TOKENS=1024
MAX_INPUT_LENGTH=2000
MAX_RETRIES=3
RATE_LIMIT_CALLS=10
RATE_LIMIT_PERIOD=60
MAX_EXECUTION_TIME_SECONDS=30
ENABLE_PII_DETECTION=True
ENABLE_TOXICITY_FILTER=True
ENABLE_HALLUCINATION_CHECK=True
